module sh.sysl.slapack.heap

import sh.sysl.sblas.{Real, Matrix, MatrixMut, GemmWork, Side, Uplo}
import sh.sysl.slapack.{Error, Transpose, QrWork, getrf, getrf_work_len, getrs, getrs_work_len, potrf, potrf_work_len, potrs, potrs_work_len, geqrf, geqrf_work_len, orgqr, orgqr_work_len, ormqr, ormqr_work_len, Eigen, SyevWork, syev, syev_work_len, sytrd, sytrd_work_len, orgtr, orgtr_work_len, SvdJob, SvdWork, Reflectors, gesvd, gesvd_work_len, gebrd, gebrd_work_len, orgbr, orgbr_work_len}
import sysl.buf.{Buf, buf_filled}

// The routines of sh.sysl.slapack that need scratch storage, in the form that allocates it per call.
// sh.sysl.slapack itself is `@no_alloc`, so it runs on a board with no heap; this module is the
// convenience for a program that has one.

/** `getrf`, with its packing buffers allocated for the call and freed after it. */
getrf_alloc[T: Real](a: MatrixMut[T], ipiv: []usize) -> Result[unit, Error]
    val len = getrf_work_len[T](a.rows, a.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    getrf(a, ipiv, GemmWork(pa.view(), pb.view()))

/** `getrs`, with its packing buffers allocated for the call and freed after it. */
getrs_alloc[T: Real](trans: Transpose, lu: Matrix[T], ipiv: []const usize, b: MatrixMut[T])
    val len = getrs_work_len[T](lu.rows, b.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    getrs(trans, lu, ipiv, b, GemmWork(pa.view(), pb.view()))

/** `potrf`, with its packing buffers allocated for the call and freed after it. */
potrf_alloc[T: Real](uplo: Uplo, a: MatrixMut[T]) -> Result[unit, Error]
    val len = potrf_work_len[T](a.rows)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    potrf(uplo, a, GemmWork(pa.view(), pb.view()))

/** `potrs`, with its packing buffers allocated for the call and freed after it. */
potrs_alloc[T: Real](uplo: Uplo, f: Matrix[T], b: MatrixMut[T])
    val len = potrs_work_len[T](f.rows, b.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    potrs(uplo, f, b, GemmWork(pa.view(), pb.view()))

/** `geqrf`, with its workspace allocated for the call and freed after it. */
geqrf_alloc[T: Real](a: MatrixMut[T], tau: []T)
    val len = geqrf_work_len[T](a.rows, a.cols)
    val block: Buf[T] = buf_filled(len.block, T.zero())
    val pa: Buf[T] = buf_filled(len.gemm.a, T.zero())
    val pb: Buf[T] = buf_filled(len.gemm.b, T.zero())
    geqrf(a, tau, QrWork(block.view(), GemmWork(pa.view(), pb.view())))

/** `orgqr`, with its workspace allocated for the call and freed after it. */
orgqr_alloc[T: Real](a: MatrixMut[T], tau: []const T)
    val len = orgqr_work_len[T](a.rows, a.cols, tau.len)
    val block: Buf[T] = buf_filled(len.block, T.zero())
    val pa: Buf[T] = buf_filled(len.gemm.a, T.zero())
    val pb: Buf[T] = buf_filled(len.gemm.b, T.zero())
    orgqr(a, tau, QrWork(block.view(), GemmWork(pa.view(), pb.view())))

/** `ormqr`, with its workspace allocated for the call and freed after it. */
ormqr_alloc[T: Real](side: Side, trans: Transpose, a: Matrix[T], tau: []const T, c: MatrixMut[T])
    val len = ormqr_work_len[T](side, c.rows, c.cols, tau.len)
    val block: Buf[T] = buf_filled(len.block, T.zero())
    val pa: Buf[T] = buf_filled(len.gemm.a, T.zero())
    val pb: Buf[T] = buf_filled(len.gemm.b, T.zero())
    ormqr(side, trans, a, tau, c, QrWork(block.view(), GemmWork(pa.view(), pb.view())))

/** `sytrd`, with its work vector allocated for the call and freed after it. */
sytrd_alloc[T: Real](uplo: Uplo, a: MatrixMut[T], d: []T, e: []T, tau: []T)
    val work: Buf[T] = buf_filled(sytrd_work_len[T](a.rows), T.zero())
    sytrd(uplo, a, d, e, tau, work.view())

/** `orgtr`, with its workspace allocated for the call and freed after it. */
orgtr_alloc[T: Real](uplo: Uplo, a: MatrixMut[T], tau: []const T)
    val len = orgtr_work_len[T](a.rows)
    val block: Buf[T] = buf_filled(len.block, T.zero())
    val pa: Buf[T] = buf_filled(len.gemm.a, T.zero())
    val pb: Buf[T] = buf_filled(len.gemm.b, T.zero())
    orgtr(uplo, a, tau, QrWork(block.view(), GemmWork(pa.view(), pb.view())))

/** `syev`, with its workspace allocated for the call and freed after it. */
syev_alloc[T: Real](eigen: Eigen, uplo: Uplo, a: MatrixMut[T], w: []T) -> Result[unit, Error]
    val len = syev_work_len[T](eigen, a.rows)
    val tri: Buf[T] = buf_filled(len.tri, T.zero())
    val block: Buf[T] = buf_filled(len.qr.block, T.zero())
    val pa: Buf[T] = buf_filled(len.qr.gemm.a, T.zero())
    val pb: Buf[T] = buf_filled(len.qr.gemm.b, T.zero())
    syev(eigen, uplo, a, w, SyevWork(tri.view(), QrWork(block.view(), GemmWork(pa.view(), pb.view()))))

/** `gebrd`, with its work vector allocated for the call and freed after it. */
gebrd_alloc[T: Real](a: MatrixMut[T], d: []T, e: []T, tauq: []T, taup: []T)
    val work: Buf[T] = buf_filled(gebrd_work_len[T](a.rows, a.cols), T.zero())
    gebrd(a, d, e, tauq, taup, work.view())

/** `orgbr`, with its workspace allocated for the call and freed after it. */
orgbr_alloc[T: Real](vect: Reflectors, a: MatrixMut[T], k: usize, tau: []const T)
    val len = orgbr_work_len[T](vect, a.rows, a.cols, k)
    val block: Buf[T] = buf_filled(len.block, T.zero())
    val pa: Buf[T] = buf_filled(len.gemm.a, T.zero())
    val pb: Buf[T] = buf_filled(len.gemm.b, T.zero())
    orgbr(vect, a, k, tau, QrWork(block.view(), GemmWork(pa.view(), pb.view())))

/** `gesvd`, with its workspace allocated for the call and freed after it. */
gesvd_alloc[T: Real](jobu: SvdJob, jobvt: SvdJob, a: MatrixMut[T], s: []T, u: MatrixMut[T], vt: MatrixMut[T]) -> Result[unit, Error]
    val len = gesvd_work_len[T](jobu, jobvt, a.rows, a.cols)
    val bidiag: Buf[T] = buf_filled(len.bidiag, T.zero())
    val block: Buf[T] = buf_filled(len.qr.block, T.zero())
    val pa: Buf[T] = buf_filled(len.qr.gemm.a, T.zero())
    val pb: Buf[T] = buf_filled(len.qr.gemm.b, T.zero())
    gesvd(jobu, jobvt, a, s, u, vt, SvdWork(bidiag.view(), QrWork(block.view(), GemmWork(pa.view(), pb.view()))))
