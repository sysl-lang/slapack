module sh.sysl.slapack.heap
@tests

import sh.sysl.sblas.{Side, Uplo, matrix, matrix_mut}
import sh.sysl.slapack.{Error, Transpose, Eigen, SvdJob, Reflectors}
import sysl.buf.{Buf, buf_filled}

// The allocating forms agree with the core routines, which tests_lu checks against their definitions;
// here it is enough that they size the buffers right, past a panel where the core needs them, and pass
// the answer through.

@test("getrf_alloc and getrs_alloc factor and solve a matrix past a panel, both ways")
heap_lu_blocked()
    val n: usize = 100
    // A diagonally dominant matrix with a known solution of all ones, both ways: row and column sums.
    val s: Buf[f64] = buf_filled(n * n, 0)
    for j in 0..<n
        for i in 0..<n
            s[i + j * n] = if i == j then f64(4 * n) else f64((i * 7 + j * 3) % 11) - 5
    val b: Buf[f64] = buf_filled(n, 0)
    val c: Buf[f64] = buf_filled(n, 0)
    for j in 0..<n
        for i in 0..<n
            b[i] += s[i + j * n]
            c[j] += s[i + j * n]
    val ipiv: Buf[usize] = buf_filled(n, 0)
    assert(getrf_alloc(matrix_mut(s.view(), n, n, n), ipiv.view()) == Ok(()))
    getrs_alloc(Transpose.NoTrans, matrix(s.view(), n, n, n), ipiv.view(), matrix_mut(b.view(), n, 1, n))
    getrs_alloc(Transpose.Trans, matrix(s.view(), n, n, n), ipiv.view(), matrix_mut(c.view(), n, 1, n))
    for i in 0..<n
        assert((b[i] - 1).abs() < 1e-12 && (c[i] - 1).abs() < 1e-12)

@test("getrf_alloc passes Singular through")
heap_lu_singular()
    var s: [4]f32 = [1, 2, 2, 4]
    var ipiv: [2]usize
    assert(getrf_alloc(matrix_mut(s[..], 2, 2, 2), ipiv[..]) == Err(Error.Singular(1)))

@test("potrf_alloc and potrs_alloc factor and solve a matrix past a block, from either triangle")
heap_chol_blocked()
    val n: usize = 100
    // A diagonally dominant symmetric matrix, positive definite, with a known solution of all ones.
    for uplo in [Uplo.Lower, Uplo.Upper]
        val s: Buf[f64] = buf_filled(n * n, 0)
        val b: Buf[f64] = buf_filled(n, 0)
        for j in 0..<n
            for i in 0..<n
                val v = if i == j then f64(6 * n) else f64((i * 7 + j * 7) % 11) - 5
                s[i + j * n] = v
                b[i] += v
        assert(potrf_alloc(uplo, matrix_mut(s.view(), n, n, n)) == Ok(()))
        potrs_alloc(uplo, matrix(s.view(), n, n, n), matrix_mut(b.view(), n, 1, n))
        for i in 0..<n
            assert((b[i] - 1).abs() < 1e-12)

@test("potrf_alloc passes NotPositiveDefinite through, and on empty input needs nothing")
heap_chol_not_pd()
    var s: [4]f32 = [1, 2, 2, 1]
    assert(potrf_alloc(Uplo.Lower, matrix_mut(s[..], 2, 2, 2)) == Err(Error.NotPositiveDefinite(1)))
    var e: [1]f64 = [9]
    assert(potrf_alloc(Uplo.Upper, matrix_mut(e[0..<0], 0, 0, 1)) == Ok(()))
    potrs_alloc(Uplo.Upper, matrix(e[0..<0], 0, 0, 1), matrix_mut(e[0..<0], 0, 2, 1))
    assert(e[0] == 9)

@test("geqrf_alloc, orgqr_alloc and ormqr_alloc factor past a block: Qᵀ A is R, and Q Qᵀ C is C")
heap_qr_blocked()
    val m: usize = 100
    val n: usize = 80
    val s: Buf[f64] = buf_filled(m * n, 0)
    for j in 0..<n
        for i in 0..<m
            s[i + j * m] = f64((i * 7 + j * 3) % 11) - 5 + (if i == j then 20 else 0)
    val a: Buf[f64] = buf_filled(m * n, 0)
    for i in 0..<m * n do a[i] = s[i]
    val tau: Buf[f64] = buf_filled(n, 0)
    geqrf_alloc(matrix_mut(s.view(), m, n, m), tau.view())
    // Qᵀ A, from the left, is R.
    ormqr_alloc(Side.Left, Transpose.Trans, matrix(s.view(), m, n, m), tau.view(), matrix_mut(a.view(), m, n, m))
    for j in 0..<n
        for i in 0..<m
            val want = if i <= j then s[i + j * m] else 0
            assert((a[i + j * m] - want).abs() < 1e-11)
    // C Q Qᵀ, from the right, is C again.
    val c: Buf[f64] = buf_filled(3 * m, 0)
    for i in 0..<3 * m do c[i] = f64(i % 13)
    ormqr_alloc(Side.Right, Transpose.NoTrans, matrix(s.view(), m, n, m), tau.view(), matrix_mut(c.view(), 3, m, 3))
    ormqr_alloc(Side.Right, Transpose.Trans, matrix(s.view(), m, n, m), tau.view(), matrix_mut(c.view(), 3, m, 3))
    for i in 0..<3 * m
        assert((c[i] - f64(i % 13)).abs() < 1e-11)
    // The thin Q has orthonormal columns.
    orgqr_alloc(matrix_mut(s.view(), m, n, m), tau.view())
    for j in 0..<n
        var d = 0.0
        for i in 0..<m do d += s[i + j * m] * s[i + j * m]
        assert((d - 1).abs() < 1e-12)

@test("the QR allocating forms on empty input need nothing and do nothing")
heap_qr_empty()
    var s: [1]f32 = [9]
    var tau: [1]f32 = [7]
    geqrf_alloc(matrix_mut(s[0..<0], 0, 4, 1), tau[..])
    orgqr_alloc(matrix_mut(s[0..<0], 0, 0, 1), tau[0..<0])
    ormqr_alloc(Side.Left, Transpose.NoTrans, matrix(s[0..<0], 0, 0, 1), tau[0..<0], matrix_mut(s[0..<0], 0, 3, 1))
    assert(s[0] == 9 && tau[0] == 7)

@test("getrf_alloc and getrs_alloc on empty input need nothing and do nothing")
heap_lu_empty()
    var s: [1]f64 = [9]
    var ipiv: [1]usize = [7]
    assert(getrf_alloc(matrix_mut(s[0..<0], 0, 3, 1), ipiv[..]) == Ok(()))
    getrs_alloc(Transpose.NoTrans, matrix(s[0..<0], 0, 0, 1), ipiv[0..<0], matrix_mut(s[0..<0], 0, 2, 1))
    assert(s[0] == 9 && ipiv[0] == 7)

/** The symmetric 100 x 100 test matrix: a diagonal 0, 1, …, 99 plus a small symmetric perturbation. */
private symmetric(n: usize) -> Buf[f64]
    val s: Buf[f64] = buf_filled(n * n, 0)
    for j in 0..<n
        for i in 0..<n
            s[i + j * n] = (if i == j then f64(i) else 0) + (f64((i * 7 + j * 7) % 11) - 5) / 1000
    s

@test("syev_alloc past a block, from either triangle: A V = V Λ, and the values alone agree")
heap_syev()
    val n: usize = 100
    for uplo in [Uplo.Lower, Uplo.Upper]
        val a = symmetric(n)
        val v = symmetric(n)
        val f = symmetric(n)
        val w: Buf[f64] = buf_filled(n, 0)
        val only: Buf[f64] = buf_filled(n, 0)
        assert(syev_alloc(Eigen.Vectors, uplo, matrix_mut(v.view(), n, n, n), w.view()) == Ok(()))
        assert(syev_alloc(Eigen.Values, uplo, matrix_mut(f.view(), n, n, n), only.view()) == Ok(()))
        for j in 0..<n
            assert((w[j] - only[j]).abs() < 1e-12)
            for i in 0..<n
                var s = -w[j] * v[i + j * n]
                for p in 0..<n do s += a[i + p * n] * v[p + j * n]
                assert(s.abs() < 1e-12)

@test("sytrd_alloc and orgtr_alloc reduce past a block: Qᵀ A Q is the tridiagonal T")
heap_sytrd()
    val n: usize = 70
    for uplo in [Uplo.Lower, Uplo.Upper]
        val a = symmetric(n)
        val q = symmetric(n)
        val d: Buf[f64] = buf_filled(n, 0)
        val e: Buf[f64] = buf_filled(n - 1, 0)
        val tau: Buf[f64] = buf_filled(n - 1, 0)
        sytrd_alloc(uplo, matrix_mut(q.view(), n, n, n), d.view(), e.view(), tau.view())
        orgtr_alloc(uplo, matrix_mut(q.view(), n, n, n), tau.view())
        for j in 0..<n
            for i in 0..<n
                var s: f64 = 0
                for p in 0..<n
                    for r in 0..<n do s += q[p + i * n] * a[p + r * n] * q[r + j * n]
                val t = if i == j then d[i] else if i == j + 1 then e[j] else if j == i + 1 then e[i] else 0
                assert((s - t).abs() < 1e-12)

@test("syev_alloc passes NoConvergence through on a NaN, and on empty input needs nothing")
heap_syev_nan()
    var s: [9]f64 = [1, f64.nan(), 1, f64.nan(), 2, 1, 1, 1, 3]
    var w: [3]f64
    assert(syev_alloc(Eigen.Values, Uplo.Lower, matrix_mut(s[..], 3, 3, 3), w[..]) is Err(Error.NoConvergence(_)))
    var e: [1]f64 = [9]
    assert(syev_alloc(Eigen.Vectors, Uplo.Upper, matrix_mut(e[0..<0], 0, 0, 1), e[0..<0]) == Ok(()))
    assert(e[0] == 9)

/** The 100 x 40 test matrix of the singular value decomposition, from the symmetric one's pattern. */
private tall(m: usize, n: usize) -> Buf[f64]
    val s: Buf[f64] = buf_filled(m * n, 0)
    for j in 0..<n
        for i in 0..<m
            s[i + j * m] = (if i == j then f64(i + 1) else 0) + (f64((i * 7 + j * 5) % 11) - 5) / 1000
    s

@test("gesvd_alloc on a tall and a wide matrix, past orgqr's block: A = U Σ Vᵀ, and the values alone agree")
heap_gesvd()
    val m: usize = 100
    val n: usize = 40
    val a = tall(m, n)
    for wide in [false, true]
        val (r, c) = if wide then (n, m) else (m, n)
        // The wide matrix is the tall one's transpose, read row-major.
        val f = tall(m, n)
        val g = tall(m, n)
        val fv = matrix_mut(f.view(), m, n, m)
        val gv = matrix_mut(g.view(), m, n, m)
        val u: Buf[f64] = buf_filled(r * r, 0)
        val vt: Buf[f64] = buf_filled(c * c, 0)
        val s: Buf[f64] = buf_filled(n, 0)
        val only: Buf[f64] = buf_filled(n, 0)
        assert(gesvd_alloc(SvdJob.Full, SvdJob.Full, if wide then fv.t() else fv, s.view(), matrix_mut(u.view(), r, r, r), matrix_mut(vt.view(), c, c, c)) == Ok(()))
        assert(gesvd_alloc(SvdJob.Omit, SvdJob.Omit, if wide then gv.t() else gv, only.view(), matrix_mut(u.view()[0..<0], 0, 0, 1), matrix_mut(vt.view()[0..<0], 0, 0, 1)) == Ok(()))
        for k in 0..<n do assert(s[k] == only[k])
        for j in 0..<c
            for i in 0..<r
                var x: f64 = 0
                for p in 0..<n do x += u[i + p * r] * s[p] * vt[p + j * c]
                val want = if wide then a[j + i * m] else a[i + j * m]
                assert((x - want).abs() < 1e-12)

@test("gebrd_alloc and orgbr_alloc reduce a tall matrix past orgqr's block: Qᵀ A P is the bidiagonal B")
heap_gebrd()
    val m: usize = 100
    val n: usize = 40
    val a = tall(m, n)
    val f = tall(m, n)
    val d: Buf[f64] = buf_filled(n, 0)
    val e: Buf[f64] = buf_filled(n - 1, 0)
    val tauq: Buf[f64] = buf_filled(n, 0)
    val taup: Buf[f64] = buf_filled(n, 0)
    gebrd_alloc(matrix_mut(f.view(), m, n, m), d.view(), e.view(), tauq.view(), taup.view())
    val q = copy(f)
    val pt: Buf[f64] = buf_filled(n * n, 0)
    for j in 0..<n
        for i in 0..<j do pt[i + j * n] = f[i + j * m]
    orgbr_alloc(Reflectors.Q, matrix_mut(q.view(), m, n, m), n, tauq.view())
    orgbr_alloc(Reflectors.P, matrix_mut(pt.view(), n, n, n), m, taup.view())
    for j in 0..<n
        for i in 0..<n
            var x: f64 = 0
            for p in 0..<m
                for r in 0..<n do x += q[p + i * m] * a[p + r * m] * pt[j + r * n]
            val b = if i == j then d[i] else if j == i + 1 then e[i] else 0
            assert((x - b).abs() < 1e-12)

/** A copy of `b`. */
private copy(b: Buf[f64]) -> Buf[f64]
    val c: Buf[f64] = buf_filled(b.len(), 0)
    for i in 0..<b.len() do c[i] = b[i]
    c

@test("gesvd_alloc passes NoConvergence through on a NaN, and on empty input needs nothing")
heap_gesvd_nan()
    var s: [12]f64 = [1, 2, f64.nan(), 4, 5, 6, 7, 8, 9, 1, 2, 4]
    var w: [3]f64
    var none: [1]f64 = [9]
    assert(gesvd_alloc(SvdJob.Omit, SvdJob.Omit, matrix_mut(s[..], 4, 3, 4), w[..], matrix_mut(none[0..<0], 0, 0, 1), matrix_mut(none[0..<0], 0, 0, 1)) is Err(Error.NoConvergence(_)))
    assert(gesvd_alloc(SvdJob.Thin, SvdJob.Thin, matrix_mut(none[0..<0], 0, 0, 1), none[0..<0], matrix_mut(none[0..<0], 0, 0, 1), matrix_mut(none[0..<0], 0, 0, 1)) == Ok(()))
    assert(none[0] == 9)
