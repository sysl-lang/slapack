module sh.sysl.slapack_oracle
@tests

import sh.sysl.lapack.Scalar
import sh.sysl.sblas.{Real, Uplo}
import sh.sysl.slapack.Eigen
import sysl.buf.{Buf, buf_filled}
import sysl.math.{min, max}

/** A deterministic stream of matrix elements in [-1, 1], from a 64-bit xorshift. */
private struct Stream
    state: u64

impl Stream
    next[T: Real](*self) -> T
        self.state ^= self.state << 13
        self.state ^= self.state >> 7
        self.state ^= self.state << 17
        T(int(self.state >> 53) - 1024) / T(1024)

/** Factors one random `m` x `n` matrix both ways, with `zeros` columns zeroed, and checks that the two
 * agree: the same pivots, the same first zero pivot, and every factor within `64 · max(m, n) · ε` of
 * the platform's, relative to the largest factor.
 */
private agree[T: Real + Scalar](m: usize, n: usize, zeros: []const usize, seed: u64)
    var g = Stream(seed)
    val a: Buf[T] = buf_filled(m * n, T.zero())
    for i in 0..<a.len() do a[i] = g.next[T]()
    for c in zeros
        for i in 0..<m do a[i + c * m] = T.zero()
    val mine = slapack_lu(a.view(), m, n)
    val theirs = platform_lu(a.view(), m, n)
    assert(mine.zero == theirs.zero, s"the first zero pivot differs at $m x $n")
    for i in 0..<mine.ipiv.len()
        assert(mine.ipiv[i] == theirs.ipiv[i], s"pivot $i differs at $m x $n: ${mine.ipiv[i]} against ${theirs.ipiv[i]}")
    var most = T.zero()
    for i in 0..<a.len()
        if theirs.factors[i].abs() > most then most = theirs.factors[i].abs()
    val tol = T(64 * (if m > n then m else n)) * T.epsilon() * most
    for i in 0..<a.len()
        val d = (mine.factors[i] - theirs.factors[i]).abs()
        assert(d <= tol, s"factor $i differs by ${f64(d)} at $m x $n")

private sweep[T: Real + Scalar]()
    val none: [0]usize = []
    for n in 1..64
        agree[T](n, n, none[..], u64(n))
    val shapes: [10](usize, usize) = [(65, 65), (100, 100), (129, 129), (200, 200), (150, 70), (70, 150), (200, 65), (65, 200), (7, 3), (3, 7)]
    for (m, n) in shapes
        agree[T](m, n, none[..], u64(m * 1000 + n))

@test("getrf agrees with the platform's dgetrf: pivots and factors, square orders 1 to 64 and blocked, tall and wide shapes")
oracle_getrf_f64()
    sweep[f64]()

@test("getrf agrees with the platform's sgetrf: pivots and factors, square orders 1 to 64 and blocked, tall and wide shapes")
oracle_getrf_f32()
    sweep[f32]()

@test("getrf names the same first zero pivot as the platform's, within a panel and past one")
oracle_getrf_singular()
    val early: [1]usize = [5]
    agree[f64](40, 40, early[..], 1)
    val two: [2]usize = [70, 90]
    agree[f64](120, 120, two[..], 2)
    val last: [1]usize = [99]
    agree[f32](100, 100, last[..], 3)

/** Factors one random symmetric positive definite matrix of order `n` (Bᵀ B + n I) both ways from its
 * `uplo` triangle, with `A(k, k)` zeroed for a `bad` k so that the minor of order `k + 1` is not
 * positive definite. The two must name the same failing column; on success every element of the
 * factor agrees within `64 · n · ε` of the largest, and slapack's did not touch the other triangle.
 */
private agree_chol[T: Real + Scalar](uplo: Uplo, n: usize, bad: Option[usize], seed: u64)
    var g = Stream(seed)
    val b: Buf[T] = buf_filled(n * n, T.zero())
    for i in 0..<b.len() do b[i] = g.next[T]()
    val a: Buf[T] = buf_filled(n * n, T.zero())
    val other = T(7)
    for j in 0..<n
        for i in 0..<n
            val inside = if uplo == Uplo.Lower then i >= j else i <= j
            var s = if i == j then T(n) else T.zero()
            for p in 0..<n
                s = s + b[p + i * n] * b[p + j * n]
            a[i + j * n] = if inside then s else other
    if bad is Some(k) then a[k + k * n] = T.zero()
    val mine = slapack_chol(uplo, a.view(), n)
    val theirs = platform_chol(uplo, a.view(), n)
    assert(mine.failed == theirs.failed, s"the failing column differs at order $n")
    assert(mine.failed == bad, s"the failing column is not the zeroed diagonal at order $n")
    if bad.is_some() then return
    var most = T.zero()
    for i in 0..<a.len()
        if theirs.factor[i].abs() > most then most = theirs.factor[i].abs()
    val tol = T(64 * n) * T.epsilon() * most
    for j in 0..<n
        for i in 0..<n
            val at = i + j * n
            if (if uplo == Uplo.Lower then i < j else i > j)
                // Only slapack's is held to this: Accelerate's potrf writes the other triangle from order
                // 33 on, though LAPACK documents it as not referenced.
                assert(mine.factor[at] == other, s"potrf wrote the other triangle at ($i, $j), order $n")
            else
                val d = (mine.factor[at] - theirs.factor[at]).abs()
                assert(d <= tol, s"factor element ($i, $j) differs by ${f64(d)} at order $n")

private sweep_chol[T: Real + Scalar]()
    for uplo in [Uplo.Lower, Uplo.Upper]
        for n in 1..64
            agree_chol[T](uplo, n, None, u64(n))
        val orders: [5]usize = [65, 100, 128, 129, 200]
        for n in orders
            agree_chol[T](uplo, n, None, u64(n * 1000))

@test("potrf agrees with the platform's dpotrf from either triangle: orders 1 to 64 and blocked")
oracle_potrf_f64()
    sweep_chol[f64]()

@test("potrf agrees with the platform's spotrf from either triangle: orders 1 to 64 and blocked")
oracle_potrf_f32()
    sweep_chol[f32]()

/** Factors one random `m` x `n` matrix, with `zeros` columns zeroed, by slapack's geqrf and the
 * platform's, and checks that they agree to within `64 · max(m, n) · ε`: each row of R up to the sign
 * of its diagonal — a reflector may take a column to `−beta` instead of `beta` — and, where the signs
 * agree, τ and the reflector, or, where they do not, τ + τ' = 2. Answers how many rows' signs differ.
 */
private agree_qr[T: Real + Scalar](m: usize, n: usize, zeros: []const usize, seed: u64) -> usize
    var g = Stream(seed)
    val a: Buf[T] = buf_filled(m * n, T.zero())
    for i in 0..<a.len() do a[i] = g.next[T]()
    for c in zeros
        for i in 0..<m do a[i + c * m] = T.zero()
    val mine = slapack_qr(a.view(), m, n)
    val theirs = platform_qr(a.view(), m, n)
    var most = T.zero()
    for i in 0..<a.len()
        if theirs.factors[i].abs() > most then most = theirs.factors[i].abs()
    val eps = T(64 * (if m > n then m else n)) * T.epsilon()
    val tol = eps * most
    var flipped: usize = 0
    for i in 0..<mine.tau.len()
        val (r, s) = (mine.factors[i + i * m], theirs.factors[i + i * m])
        val same = (r < T.zero()) == (s < T.zero())
        if !same then flipped += 1
        val sign = if same then T.one() else -T.one()
        for j in i..<n
            val d = (mine.factors[i + j * m] - sign * theirs.factors[i + j * m]).abs()
            assert(d <= tol, s"R($i, $j) differs by ${f64(d)} at $m x $n")
        val (t, u) = (mine.tau[i], theirs.tau[i])
        if same
            assert((t - u).abs() <= eps, s"τ $i is ${f64(t)} against ${f64(u)} at $m x $n")
            for p in i + 1..<m
                val d = (mine.factors[p + i * m] - theirs.factors[p + i * m]).abs()
                assert(d <= eps, s"reflector $i differs by ${f64(d)} in row $p at $m x $n")
        else
            assert((t + u - T(2)).abs() <= eps, s"τ $i is ${f64(t)} against ${f64(u)}, flipped, at $m x $n")
    flipped

private sweep_qr[T: Real + Scalar]()
    val none: [0]usize = []
    var flipped: usize = 0
    for n in 1..64
        flipped += agree_qr[T](n, n, none[..], u64(n))
    val shapes: [14](usize, usize) = [(65, 65), (100, 100), (128, 128), (129, 129), (193, 193), (200, 200), (150, 70), (70, 150), (200, 65), (65, 200), (130, 3), (3, 130), (7, 3), (3, 7)]
    for (m, n) in shapes
        flipped += agree_qr[T](m, n, none[..], u64(m * 1000 + n))
    assert(flipped == 0, s"$flipped rows of R have the opposite sign to the platform's")

@test("geqrf agrees with the platform's dgeqrf: R, τ and the reflectors, square orders 1 to 64 and blocked, tall and wide shapes")
oracle_geqrf_f64()
    sweep_qr[f64]()

@test("geqrf agrees with the platform's sgeqrf: R, τ and the reflectors, square orders 1 to 64 and blocked, tall and wide shapes")
oracle_geqrf_f32()
    sweep_qr[f32]()

@test("geqrf agrees with the platform's on zero columns: τ zero where the platform's is, and R's column zero")
oracle_geqrf_zero_columns()
    val cols: [4]usize = [0, 31, 32, 99]
    _ = agree_qr[f64](130, 100, cols[..], 1)
    val first: [1]usize = [0]
    _ = agree_qr[f32](20, 20, first[..], 2)

/** A random symmetric order-`n` matrix, both triangles, column-major. */
private symmetric[T: Real](n: usize, seed: u64) -> Buf[T]
    var g = Stream(seed)
    val a: Buf[T] = buf_filled(n * n, T.zero())
    for j in 0..<n
        for i in j..<n
            val x = g.next[T]()
            a[i + j * n] = x
            a[j + i * n] = x
    a

/** Solves one random symmetric matrix of order `n` from `uplo` by slapack's syev and the platform's,
 * values and vectors, and checks that they agree: every eigenvalue within `64 · n · ε · ‖A‖₁`, the
 * values alone the same, and each eigenvector, up to its sign, within that over the eigenvalue's gap
 * to its nearest neighbour — the bound on how far rounding can turn an eigenvector.
 */
private agree_eig[T: Real + Syev](uplo: Uplo, n: usize, seed: u64)
    val a = symmetric[T](n, seed)
    val mine = slapack_eig(Eigen.Vectors, uplo, a.view(), n)
    val theirs = platform_eig(Eigen.Vectors, uplo, a.view(), n)
    assert(mine.unconverged == 0 && theirs.unconverged == 0, s"an iteration did not converge at $n")
    var norm = T.zero()
    for j in 0..<n
        var sum = T.zero()
        for i in 0..<n do sum = sum + a[i + j * n].abs()
        if sum > norm then norm = sum
    val tol = T(64 * n) * T.epsilon() * norm
    for i in 0..<n
        val d = (mine.values[i] - theirs.values[i]).abs()
        assert(d <= tol, s"eigenvalue $i differs by ${f64(d)} at $n")
    for j in 0..<n
        var gap = T.max_value()
        if j > 0 then gap = theirs.values[j] - theirs.values[j - 1]
        if j + 1 < n && theirs.values[j + 1] - theirs.values[j] < gap then gap = theirs.values[j + 1] - theirs.values[j]
        var dot = T.zero()
        for i in 0..<n do dot = dot + mine.vectors[i + j * n] * theirs.vectors[i + j * n]
        val sign = if dot < T.zero() then -T.one() else T.one()
        val vtol = if tol / gap < T.one() then tol / gap else T.one()
        for i in 0..<n
            val d = (mine.vectors[i + j * n] - sign * theirs.vectors[i + j * n]).abs()
            assert(d <= vtol, s"eigenvector $j differs by ${f64(d)} in row $i at $n, its gap ${f64(gap)}")
    val only = slapack_eig(Eigen.Values, uplo, a.view(), n)
    val their_only = platform_eig(Eigen.Values, uplo, a.view(), n)
    assert(only.unconverged == 0 && their_only.unconverged == 0)
    for i in 0..<n
        val d = (only.values[i] - their_only.values[i]).abs()
        assert(d <= tol, s"eigenvalue $i alone differs by ${f64(d)} at $n")

private sweep_eig[T: Real + Syev]()
    for uplo in [Uplo.Lower, Uplo.Upper]
        for n in 1..64
            agree_eig[T](uplo, n, u64(n))
        val orders: [4]usize = [65, 100, 128, 129]
        for n in orders
            agree_eig[T](uplo, n, u64(n) * 7)

@test("syev agrees with the platform's dsyev from either triangle: values, the values alone, and vectors up to sign, orders 1 to 64 and past orgqr's block")
oracle_syev_f64()
    sweep_eig[f64]()

@test("syev agrees with the platform's ssyev from either triangle: values, the values alone, and vectors up to sign, orders 1 to 64 and past orgqr's block")
oracle_syev_f32()
    sweep_eig[f32]()

@test("syev and the platform's both answer that the iteration did not converge on a matrix holding a NaN")
oracle_syev_nan()
    val n: usize = 10
    val a = symmetric[f64](n, 9)
    a[7 + 3 * n] = f64.nan()
    a[3 + 7 * n] = f64.nan()
    for uplo in [Uplo.Lower, Uplo.Upper]
        for eigen in [Eigen.Vectors, Eigen.Values]
            val mine = slapack_eig(eigen, uplo, a.view(), n)
            val theirs = platform_eig(eigen, uplo, a.view(), n)
            assert(mine.unconverged > 0, "slapack's syev converged on a NaN")
            assert(theirs.unconverged > 0, "the platform's syev converged on a NaN")

@test("potrf names the same failing minor as the platform's, within a block and past one")
oracle_potrf_not_pd()
    for uplo in [Uplo.Lower, Uplo.Upper]
        agree_chol[f64](uplo, 40, Some(5), 1)
        agree_chol[f64](uplo, 40, Some(0), 2)
        agree_chol[f64](uplo, 150, Some(64), 3)
        agree_chol[f64](uplo, 150, Some(120), 4)
        agree_chol[f32](uplo, 100, Some(99), 5)

/** A random column-major `m` x `n` matrix. */
private rectangular[T: Real](m: usize, n: usize, seed: u64) -> Buf[T]
    var g = Stream(seed)
    val a: Buf[T] = buf_filled(m * n, T.zero())
    for i in 0..<m * n do a[i] = g.next[T]()
    a

/** Decomposes one random `m` x `n` matrix by slapack's gesvd and the platform's, with every vector and
 * with none, and checks that they agree: every singular value within `64 · max(m, n) · ε · ‖A‖₁`, the
 * values alone the same, and each of the first min(m, n) columns of U and rows of Vᵀ, up to a sign the
 * pair shares, within that over the value's gap to its nearest neighbour — and to zero, where U or V has
 * vectors past min(m, n) — the bound on how far rounding can turn a singular vector.
 */
private agree_svd[T: Real + Gesvd](m: usize, n: usize, seed: u64)
    val a = rectangular[T](m, n, seed)
    val at = s"$m x $n"
    val k = min(m, n)
    val mine = slapack_svd(true, a.view(), m, n)
    val theirs = platform_svd(true, a.view(), m, n)
    assert(mine.unconverged == 0 && theirs.unconverged == 0, s"an iteration did not converge at $at")
    var norm = T.zero()
    for j in 0..<n
        var sum = T.zero()
        for i in 0..<m do sum = sum + a[i + j * m].abs()
        if sum > norm then norm = sum
    val tol = T(64 * max(m, n)) * T.epsilon() * norm
    for i in 0..<k
        val d = (mine.values[i] - theirs.values[i]).abs()
        assert(d <= tol, s"singular value $i differs by ${f64(d)} at $at")
    for j in 0..<k
        val sv = theirs.values
        var gap = if m != n then sv[j] else T.max_value()
        if j > 0 && sv[j - 1] - sv[j] < gap then gap = sv[j - 1] - sv[j]
        if j + 1 < k && sv[j] - sv[j + 1] < gap then gap = sv[j] - sv[j + 1]
        var dot = T.zero()
        for i in 0..<m do dot = dot + mine.u[i + j * m] * theirs.u[i + j * m]
        val sign = if dot < T.zero() then -T.one() else T.one()
        val vtol = if tol / gap < T.one() then tol / gap else T.one()
        for i in 0..<m
            val d = (mine.u[i + j * m] - sign * theirs.u[i + j * m]).abs()
            assert(d <= vtol, s"U's column $j differs by ${f64(d)} in row $i at $at, its gap ${f64(gap)}")
        for i in 0..<n
            val d = (mine.vt[j + i * n] - sign * theirs.vt[j + i * n]).abs()
            assert(d <= vtol, s"Vᵀ's row $j differs by ${f64(d)} in column $i at $at, its gap ${f64(gap)}")
    val only = slapack_svd(false, a.view(), m, n)
    val their_only = platform_svd(false, a.view(), m, n)
    assert(only.unconverged == 0 && their_only.unconverged == 0)
    for i in 0..<k
        val d = (only.values[i] - their_only.values[i]).abs()
        assert(d <= tol, s"singular value $i alone differs by ${f64(d)} at $at")

private sweep_svd[T: Real + Gesvd]()
    for n in 1..64
        agree_svd[T](n, n, u64(n))
    val orders: [4]usize = [65, 100, 128, 129]
    for n in orders
        agree_svd[T](n, n, u64(n) * 11)
    val shapes: [8](usize, usize) = [(150, 70), (70, 150), (200, 65), (65, 200), (130, 3), (3, 130), (300, 100), (100, 300)]
    for (m, n) in shapes
        agree_svd[T](m, n, u64(m * n))

@test("gesvd agrees with the platform's dgesvd: values, the values alone, and U and Vᵀ up to sign, square orders 1 to 64 and past orgqr's block, tall and wide shapes")
oracle_gesvd_f64()
    sweep_svd[f64]()

@test("gesvd agrees with the platform's sgesvd: values, the values alone, and U and Vᵀ up to sign, square orders 1 to 64 and past orgqr's block, tall and wide shapes")
oracle_gesvd_f32()
    sweep_svd[f32]()

@test("on a matrix holding a NaN slapack's gesvd answers that the iteration did not converge from either job; the platform's does with the vectors, and without them answers success")
oracle_gesvd_nan()
    val shapes: [2](usize, usize) = [(10, 7), (7, 10)]
    for (m, n) in shapes
        val a = rectangular[f64](m, n, 13)
        a[4 + 3 * m] = f64.nan()
        for vectors in [true, false]
            val mine = slapack_svd(vectors, a.view(), m, n)
            val theirs = platform_svd(vectors, a.view(), m, n)
            assert(mine.unconverged > 0, s"slapack's gesvd converged on a NaN at $m x $n")
            // Without vectors the platform's runs dqds (dlasq1), whose dlascl refuses the NaN scale through
            // xerbla — printed, not fatal — and gesvd then answers info = 0 (observed on macOS, sysl 0.8.3).
            if vectors
                assert(theirs.unconverged > 0, s"the platform's gesvd converged on a NaN at $m x $n")
            else
                assert(theirs.unconverged == 0, s"the platform's gesvd of the values now reports a NaN at $m x $n")
                var nan = false
                for i in 0..<min(m, n) do nan = nan || theirs.values[i].is_nan()
                assert(nan, s"the platform's values hold no NaN at $m x $n")
